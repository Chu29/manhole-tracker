{
  "name": "manhole-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Manhole tracking app — monorepo (React Native mobile app + Node/Express backend)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "mobile": "pnpm --filter mobile run start",
    "backend": "pnpm --filter backend run dev",
    "backend:dev": "pnpm --filter backend run dev",
    "backend:migrate": "pnpm --filter backend run migrate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "setup:local": "pnpm run db:up && echo 'Waiting for database...' && sleep 5 && pnpm run backend:migrate",
    "lint": "pnpm --filter mobile run lint",
    "dev:admin": "pnpm --filter @manhole-tracker/admin run dev"
  },
  "overrides": {
    "react-native-worklets": "0.5.1"
  },
  "license": "ISC",
  "type": "module"
}
